NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/trustloop

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional — Razorpay TEST MODE keys (from your Razorpay dashboard, "Test Mode" toggle on).
# Without these, contributions stay admin-confirmed only; self-service payment
# via Razorpay checkout is disabled but nothing else breaks.
# Never put live/production keys here or anywhere in this repo.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
