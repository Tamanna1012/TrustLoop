# Leave unset for local development — the Vite dev server proxies /api to
# http://localhost:5000 (see vite.config.ts), so no configuration is needed.
#
# In production, the frontend (e.g. Vercel) and backend (e.g. Render) are on
# different domains, so this MUST be set to the backend's full origin,
# including the /api suffix, e.g.:
#   VITE_API_URL=https://trustloop-api.onrender.com/api
VITE_API_URL=
